rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'gusguecas@gmail.com';
    }
    // Familia = quien se anotó con el código familiar (members/{uid}) o el admin.
    // Tener cuenta de Firebase NO basta: cualquiera puede crear una.
    function isFamily() {
      return isAdmin() || (request.auth != null
        && exists(/databases/$(database)/documents/members/$(request.auth.uid)));
    }

    // El código familiar. Nadie lo lee desde la app; solo estas reglas lo consultan.
    match /config/familyCode {
      allow read: if false;
      allow write: if isAdmin();
    }

    // Anotarse como familia: solo con el código correcto y solo para uno mismo.
    match /members/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['code', 'name', 'email', 'joinedAt'])
        && request.resource.data.code
           == get(/databases/$(database)/documents/config/familyCode).data.code;
      allow update, delete: if isAdmin();
    }

    // Lo que escribe la familia: cada quien crea a su nombre (authorUid) y solo
    // edita o borra lo suyo. El admin puede todo (regla de abajo). Lectura: abajo.
    function ownCreate() {
      return isFamily() && request.resource.data.authorUid == request.auth.uid;
    }
    function ownChange() {
      return isFamily() && resource.data.get('authorUid', '') == request.auth.uid
        && request.resource.data.authorUid == request.auth.uid;
    }
    function ownDelete() {
      return isFamily() && resource.data.get('authorUid', '') == request.auth.uid;
    }
    match /{col}/{doc} {
      allow create: if col in ['traditions', 'messages', 'familyMessages', 'familyQuotes'] && ownCreate();
      allow update: if col in ['traditions', 'messages', 'familyMessages', 'familyQuotes'] && ownChange();
      allow delete: if col in ['traditions', 'messages', 'familyMessages', 'familyQuotes'] && ownDelete();
    }

    // Homenaje: los recuerdos van en una lista dentro de cada tarjeta. La familia
    // solo puede tocar esa lista, y solo agregar/cambiar/quitar UN recuerdo suyo.
    function memoriesChangeIsOwn() {
      let before = resource.data.get('memories', []);
      let after = request.resource.data.get('memories', []);
      let removed = before.removeAll(after);
      let added = after.removeAll(before);
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memories'])
        && removed.size() <= 1 && added.size() <= 1
        && after.size() - before.size() == added.size() - removed.size()
        && (removed.size() == 0 || removed[0].get('authorUid', '') == request.auth.uid)
        && (added.size() == 0 || added[0].get('authorUid', '') == request.auth.uid);
    }
    match /memorials/{doc} {
      // Primera vez que alguien escribe en la tarjeta de una persona del árbol.
      allow create: if isFamily() && request.resource.data.get('memories', []).size() == 1
        && request.resource.data.memories[0].get('authorUid', '') == request.auth.uid;
      allow update: if isFamily() && memoriesChangeIsOwn();
    }

    // Todo lo demás: lectura para la familia, escritura solo admin.
    // Las reglas se suman (OR): sin excluir config/members, esta regla dejaría
    // a la familia leer el código.
    match /{collection}/{document=**} {
      allow read: if isFamily() && !(collection in ['config', 'members']);
      allow write: if isAdmin();
    }
  }
}
