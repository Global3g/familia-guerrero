rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'gusguecas@gmail.com';
    }
    // Familia = anotada con el código familiar (ver firestore.rules, members/{uid}).
    function isFamily() {
      return isAdmin() || (request.auth != null
        && firestore.exists(/databases/(default)/documents/members/$(request.auth.uid)));
    }

    match /{allPaths=**} {
      allow read: if isFamily();
      allow write: if isAdmin();
    }
  }
}
